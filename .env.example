# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://payflow:payflow_dev@localhost:5432/payflow_dev"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Webhook delivery ────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET="change-me-webhook-signing-secret"
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAYS="[30,120,600,3600,86400]"  # seconds: 30s,2m,10m,1h,24h

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT_RPM=1000       # requests per minute per API key
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Encryption ──────────────────────────────────────────────────────────────
ENCRYPTION_KEY="change-me-32-char-encryption-key!!"   # AES-256 key

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=""

# ─── Web app ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
